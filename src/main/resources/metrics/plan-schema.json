{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "in_domain": {
      "type": "boolean"
    },
    "reply": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "metric": {
                "type": "string"
              },
              "exchanges": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "binance",
                    "okx"
                  ]
                }
              },
              "instrument": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "market_type": {
                    "type": "string"
                  },
                  "base": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string"
                  },
                  "settle": {
                    "type": "string"
                  }
                },
                "required": [
                  "market_type",
                  "base",
                  "quote"
                ]
              },
              "query_shape": {
                "type": "string",
                "enum": [
                  "range_statistic",
                  "time_series",
                  "snapshot",
                  "official_24h",
                  "recent_n"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "description": "最近 N 期的期数；query_shape=recent_n 时必填，没有默认值"
              },
              "time": {
                "type": "object",
                "description": "时间窗口，仅 range_statistic / time_series 需要；query_shape=recent_n 时必须完全省略"
              },
              "interval": {
                "type": "string",
                "enum": [
                  "5m",
                  "15m",
                  "30m",
                  "1h",
                  "2h",
                  "4h",
                  "6h",
                  "12h",
                  "1d"
                ]
              },
              "include_unclosed": {
                "type": "boolean"
              },
              "depth": {
                "type": "integer",
                "minimum": 5,
                "maximum": 50,
                "description": "盘口档位数，仅声明 depth 的指标可用"
              }
            },
            "required": [
              "id",
              "metric",
              "exchanges",
              "instrument",
              "query_shape"
            ]
          }
        },
        "calculations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "operator": {
                "type": "string"
              },
              "input": {
                "type": "object"
              }
            },
            "required": [
              "id",
              "operator",
              "input"
            ]
          }
        }
      },
      "required": [
        "metrics",
        "calculations"
      ]
    }
  },
  "required": [
    "in_domain",
    "reply",
    "plan"
  ]
}
