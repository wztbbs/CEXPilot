{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "in_domain": {
      "type": "boolean"
    },
    "reply": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "metric": {
                "type": "string"
              },
              "exchanges": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "binance",
                    "okx"
                  ]
                }
              },
              "instrument": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "market_type": {
                    "type": "string",
                    "enum": [
                      "perpetual",
                      "spot"
                    ]
                  },
                  "base": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string"
                  },
                  "settle": {
                    "type": "string"
                  }
                },
                "required": [
                  "market_type",
                  "base",
                  "quote"
                ]
              },
              "query_shape": {
                "type": "string",
                "enum": [
                  "range_statistic",
                  "time_series",
                  "snapshot",
                  "official_24h",
                  "recent_n"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "description": "最近 N 期的期数；query_shape=recent_n 时必填，没有默认值"
              },
              "time": {
                "type": "object",
                "description": "时间窗口，仅 range_statistic / time_series 需要；query_shape=recent_n 时必须完全省略"
              },
              "interval": {
                "type": "string",
                "enum": [
                  "5m",
                  "15m",
                  "30m",
                  "1h",
                  "2h",
                  "4h",
                  "6h",
                  "12h",
                  "1d"
                ]
              },
              "include_unclosed": {
                "type": "boolean"
              },
              "depth": {
                "type": "integer",
                "minimum": 5,
                "maximum": 50,
                "description": "盘口档位数，仅声明 depth 的指标可用"
              },
              "reference_mode": {
                "type": "string",
                "enum": [
                  "pinned_result",
                  "latest"
                ],
                "description": "pinned_result=绑定【可引用历史事实】中的已验证快照（必填 evidence_ref）；latest 或缺省=重新取数"
              },
              "evidence_ref": {
                "type": "string",
                "description": "可引用历史事实的 ref 短别名（如 fact_1），仅 reference_mode=pinned_result 时有效"
              }
            },
            "required": [
              "id",
              "metric",
              "exchanges",
              "instrument",
              "query_shape"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "query_shape": {
                      "enum": [
                        "recent_n"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "count"
                  ],
                  "not": {
                    "required": [
                      "time"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "query_shape": {
                      "enum": [
                        "range_statistic",
                        "time_series"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "time"
                  ]
                }
              }
            ]
          }
        },
        "calculations": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "运行时由 DagPlanner 按已注册 CalculationTool.planningInputSchema 生成 operator 与 input 绑定的 anyOf 分支"
          }
        }
      },
      "required": [
        "metrics",
        "calculations"
      ]
    },
    "changes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "用户本轮明确改变的条件键；无改为 []"
    },
    "new_frame": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "旧协议兼容字段；新代码使用 task_action，显式 task_action 优先"
    },
    "needs_clarification": {
      "type": "boolean",
      "description": "缺必要条件或指代不明时必须 true，并给出非空 clarify 列表；不是 task_action=CONTINUE。"
    },
    "task_action": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "NEW",
        "CONTINUE",
        "RESUME",
        null
      ],
      "description": "NEW=新任务；CONTINUE=当前任务（含澄清/失败接续）；RESUME=回访任务及版本"
    },
    "task_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "RESUME 必填：任务索引提供的 task_ref 别名，不能编造数据库 ID"
    },
    "clarify": {
      "type": "array",
      "description": "待用户填写的必要条件；每项只问一个值，已知条件不重复问。无需澄清时为 []。",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "reason",
          "message"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "reason": {
            "type": "string",
            "enum": [
              "missing",
              "invalid",
              "confirm"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "向用户说明需补充、修改或确认什么，纠错和确认要解释具体原因"
          },
          "placeholder": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "hint": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          },
          "options": {
            "type": [
              "array",
              "null"
            ],
            "maxItems": 12,
            "items": {
              "type": "string",
              "maxLength": 80
            },
            "description": "可选参考示例，只作展示，用户可以填写其他表达，不是可选值枚举"
          },
          "value": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "description": "用户原话，用于回显，不要自行替换成代码或默认值"
          }
        }
      },
      "uniqueItems": true
    },
    "state_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "RESUME 可选：任务索引提供的 state_ref；明确回到某轮时必填，不填选择该任务最新候选版本"
    },
    "condition_updates": {
      "type": [
        "object",
        "null"
      ],
      "description": "仅声明用户本轮明确设置或恢复默认的可选参数；指标组 ID -> 参数 -> set/reset。不复制继承值，不登记来源原文，普通查询省略。set 时计划提供值，reset 时计划省略值。",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "interval": {
            "type": "string",
            "enum": [
              "set",
              "reset"
            ]
          },
          "include_unclosed": {
            "type": "string",
            "enum": [
              "set",
              "reset"
            ]
          },
          "depth": {
            "type": "string",
            "enum": [
              "set",
              "reset"
            ]
          },
          "settle": {
            "type": "string",
            "enum": [
              "set",
              "reset"
            ]
          }
        }
      }
    }
  },
  "required": [
    "in_domain",
    "reply",
    "plan",
    "needs_clarification",
    "clarify"
  ]
}
